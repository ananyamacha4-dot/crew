# Copy to .env and fill in.
# Pick one or more LLM providers. CrewAI uses LiteLLM, which routes by model prefix.

# --- Groq (cheap + fast Llama 3.3 70B; current default) ---
GROQ_API_KEY=gsk-...

# --- Anthropic (best quality; recommended for ENGINEER_MODEL and CRITIC_MODEL) ---
# ANTHROPIC_API_KEY=sk-ant-...

# --- OpenAI (legacy) ---
# OPENAI_API_KEY=sk-...

# --- Optional search keys for the legacy researcher agent ---
# SERPER_API_KEY=...

# --- Per-agent model selection ---
# Each defaults to WORKER_MODEL if unset. Use the LiteLLM model-id format.
WORKER_MODEL=groq/llama-3.3-70b-versatile

# Hybrid configuration (recommended once you have an Anthropic key):
# BRIEF_MODEL=groq/llama-3.3-70b-versatile
# DESIGN_MODEL=anthropic/claude-sonnet-4-6
# CONTENT_MODEL=groq/llama-3.3-70b-versatile
# ENGINEER_MODEL=anthropic/claude-sonnet-4-6
# CRITIC_MODEL=anthropic/claude-sonnet-4-6

# --- Pipeline knobs ---
# How many critic-driven regeneration cycles. 0 = no retry (one engineer pass),
# 1 = one regeneration after critique (default), higher = more polish at the
# cost of latency + cost.
MAX_CRITIC_ITERS=1

# --- Frontend ---
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
